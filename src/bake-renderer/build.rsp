-std=c++20
-O2
-Wall
-Wextra
-Wno-unused-const-variable
-Iinclude
-Isrc
-ffp-contract=off
-fno-fast-math
-mno-nontrapping-fptoint
-fwasm-exceptions
-sWASM_LEGACY_EXCEPTIONS=1
-sSTANDALONE_WASM=1
--no-entry
-sALLOW_MEMORY_GROWTH=1
-sINITIAL_MEMORY=67108864
-sMAXIMUM_MEMORY=2147483648
-sSTACK_SIZE=1048576
src/api.cpp
src/render.cpp
src/patch/directory.cpp
src/rom/md5.cpp
src/rom/rom.cpp
src/rom/tables.cpp
src/voice/control.cpp
src/voice/envelope.cpp
src/voice/interp.cpp
src/voice/mem.cpp
src/voice/pitch.cpp
src/voice/ramp.cpp
src/voice/sampler.cpp
src/voice/svf.cpp
src/voice/tva.cpp
src/voice/tvf.cpp
