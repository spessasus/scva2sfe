{
  "name": "scva2sfe",
  "version": "7.0.0",
  "scripts": {
    "build": "tsc --noEmit && tsc -p src/lib/tsconfig.json && tsc -p src/pool/tsconfig.json && tsc -p src/bake-renderer/tsconfig.json && tsc -p web/tsconfig.json && tsc -p web/tsconfig.worker.json",
    "build:dist": "node tools/build-dist.mjs before && tsc -p tsconfig.dist.json && node tools/build-dist.mjs after",
    "build:wasm": "node tools/build-wasm.mjs",
    "build:web": "node tools/build-web.mjs",
    "serve:web": "node tools/serve-web.mjs",
    "convert": "node bin/scva2sfe.mjs",
    "convert:dev": "tsx src/cli/main.ts",
    "test": "node --test --import tsx test/"
  },
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "spessasynth_core": "^4.4.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "scva2sfe": "bin/scva2sfe.mjs"
  },
  "files": [
    "bin/scva2sfe.mjs",
    "dist",
    "LICENSE",
    "LICENSE.NativeTS",
    "NOTICE.md",
    "README.md"
  ]
}
